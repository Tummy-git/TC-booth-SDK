<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs BoothPackageInspector.cs outside Unity against the shared cases in inspector-cases.json.
       Run from the repo root with "dotnet run" and the project option pointing at Tests/BoothPackageInspector (see Program.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Packages/name.tummy.tcboothsdk/Editor/BoothPackageInspector.cs" />
    <Compile Include="Program.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <None Include="inspector-cases.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
